  <!-- ═══════════════════════════════════════════════════════════════
       ros2_control HARDWARE INTERFACE
       Tells robot_state_publisher which joints are movable.
       Without this, RSP treats ALL joints as fixed (static TF only).
       Inlined from moveit_190/config/recomoProto2-1190.ros2_control.xacro.
       ═══════════════════════════════════════════════════════════════ -->
  <ros2_control name="FakeSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="base_joint_vx">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_joint_vy">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_joint_wz">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6_arm_yaw">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5_arm_pitch">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4_elbow_pitch">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3_gimbal_yaw">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2_gimbal_roll">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint1_gimbal_pitch">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ee1_rot_z">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ee1_rot_y">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ee1_rot_x">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ═══════════════════════════════════════════════════════════════
       CHASSIS SENSOR LINKS (merged from ros_car.urdf)
       These are fixed to base_link for perception TF lookups.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- LiDAR sensor (tower top) -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><cylinder length="0.03" radius="0.02"/></geometry>
      <material name="sensor_black"><color rgba="0.0 0.0 0.0 0.5"/></material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- IMU sensor (chassis center) -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Ground reference (for nav stack compatibility) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0.0 0.0 -0.072" rpy="0 0 0"/>
  </joint>

</robot>
