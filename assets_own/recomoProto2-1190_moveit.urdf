<?xml version="1.0" encoding="utf-8"?>
<!--
  RecomoProto2-190 MoveIt URDF

  Completed to match the current planning stack expectations:
  - planar mobile base virtual joints
  - arm_base_link mounting link
  - joint6/joint5/... naming convention
  - ee_tool and ee1_tool virtual tool links
-->
<robot
  name="recomoProto2-1190">
  <link name="base_root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-08" ixy="0" ixz="0" iyy="1e-08" iyz="0" izz="1e-08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
      <material name="world_material">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
    </collision>
  </link>

  <link name="base_vx_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
      <material name="base_gray_material">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
    </collision>
  </link>

  <link name="base_vy_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
      <material name="base_gray_material">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
    </collision>
  </link>

  <link name="base_wz_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 2.000" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
      <material name="base_gray_material">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 2.000" rpy="0 0 0"/>
      <geometry><box size="0.00 0.00 0.00"/></geometry>
    </collision>
  </link>

  <joint name="base_joint_vx" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_root" />
    <child link="base_vx_link" />
    <axis xyz="1 0 0" />
    <limit lower="-100" upper="100" effort="200" velocity="2.0" />
  </joint>

  <joint name="base_joint_vy" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_vx_link" />
    <child link="base_vy_link" />
    <axis xyz="0 1 0" />
    <limit lower="-100" upper="100" effort="200" velocity="2.0" />
  </joint>

  <joint name="base_joint_wz" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_vy_link" />
    <child link="base_wz_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="30.0" velocity="0.5" />
  </joint>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.0055307 0.01516 0.31097"
        rpy="0 0 0" />
      <mass
        value="20" />
      <inertia
        ixx="0.14156"
        ixy="8.5545E-05"
        ixz="0.00013573"
        iyy="0.14292"
