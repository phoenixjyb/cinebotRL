    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="ee1_roty_link" />
    <child link="ee1_rotx_link" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1416" upper="3.1416" effort="30.0" velocity="0.5" />
  </joint>
  <joint name="ee1_tool_mount_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="ee1_rotx_link" />
    <child link="ee1_tool" />
  </joint>
</robot>
