        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="meshes/recomoProto2-190/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="base_link_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_wz_link" />
    <child link="base_link" />
  </joint>

